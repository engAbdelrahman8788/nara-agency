# NARA workspace authentication
# Copy this file to .env.local and replace every value below.
# Never commit real credentials.

# Must be at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-secret

# Client workspace account
AUTH_CLIENT_EMAIL=client@example.com
AUTH_CLIENT_PASSWORD=replace-with-a-strong-client-password
AUTH_CLIENT_NAME=Client Name

# Agency / owner workspace account
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=replace-with-a-strong-admin-password
AUTH_ADMIN_NAME=Agency Name
